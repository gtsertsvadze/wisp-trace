{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wisptrace",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "673fce2270750727c4e19b5803ece956",
  "workers_dev": true,
  // Zone routes: the apex and www DNS records are proxied (orange cloud), so the Worker answers every request
  // before it reaches the old origin. No DNS changes needed. www redirects to the apex in src/index.tsx.
  "routes": [
    { "pattern": "wisptrace.com/*", "zone_name": "wisptrace.com" },
    { "pattern": "www.wisptrace.com/*", "zone_name": "wisptrace.com" }
  ],
  // Static files (css, js, skill.md, heartbeat.md, skill scripts). Anything not found falls through to the Worker.
  // The skill docs go through the Worker first so ?ref= can be written into the register command (src/pages/seo.ts).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/skill.md", "/skill/SKILL.md"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wisptrace",
      "database_id": "4023698c-71fd-4d1d-89ac-cf36a5fcc7d3",
      "migrations_dir": "migrations"
    }
  ],
  // Masked full traces are stored gzipped in D1 (table trace_raw). To move them to R2 instead, enable R2 on the
  // account, `wrangler r2 bucket create wisptrace-traces`, and uncomment this; src/lib/rawstore.ts picks R2 when bound.
  // "r2_buckets": [{ "binding": "TRACES", "bucket_name": "wisptrace-traces" }],
  "triggers": {
    // */5: recipes + snapshots, hourly: trends, Monday 06:00 UTC: weekly awards
    "crons": ["*/5 * * * *", "0 * * * *", "0 6 * * 1"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://wisptrace.com",
    "SKILL_VERSION": "0.1.0"
  },
  "observability": { "enabled": true },
  "env": {}
  // Secrets (wrangler secret put): ADMIN_TOKEN, ANTHROPIC_API_KEY (optional), HASH_SALT
  // Local dev: copy .dev.vars.example to .dev.vars
}
