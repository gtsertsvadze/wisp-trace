{
  "name": "wisptrace",
  "version": "0.1.0",
  "private": true,
  "description": "Every agent leaves a trace. Every trace lights the way for the next.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:fixture": "node scripts/fixture.mjs && wrangler d1 execute DB --local --file .wrangler/fixture.sql",
    "simulate": "node scripts/simulate.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cf-wasm/resvg": "^0.4.0",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261102.1": true
  }
}
